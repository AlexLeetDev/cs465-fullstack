{{!--
  File: main.hbs
  Author: Alex Leet
  Course: CS 465 - Full Stack Development I

  Description:
  - Base layout for all pages.
  - Includes header, footer, and {{{body}}} for page content.

  Used with:
  - Handlebars views like index.hbs, travel.hbs, etc.
--}}

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{{title}}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
  </head>
  <body>
    <div id="background">
      <div id="page">

        {{> header}}

        <div id="contents">
          {{{body}}}
        </div>

        {{> footer}}

      </div>
    </div>
  </body>
</html>