{{!--
  File: rooms.hbs
  Author: Alex Leet
  Course: CS 465 - Full Stack Development I

  Description:
  - Displays room options dynamically from rooms.json.
  - Placed in {{{body}}} of main.hbs.
--}}

<div class="box">
  <div>
    <div class="body">
      <h1>{{pageHeader.title}}</h1>

      <ul id="rooms">
        {{#each rooms}}
          <li>
            <img src="/images/{{image}}" alt="{{name}}">
            <h2>{{name}}</h2>
            <p>{{description}}</p>
            <span class="rate">Rate: {{rate}}</span>
          </li>
        {{/each}}
      </ul>

    </div>
  </div>
</div>