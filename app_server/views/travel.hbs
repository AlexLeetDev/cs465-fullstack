{{!--
  File: travel.hbs
  Author: Alex Leet
  Course: CS 465 - Full Stack Development I

  Description:
  - Displays a list of travel packages dynamically from trips.json.
  - Placed in {{{body}}} of main.hbs.
--}}

<div class="box">
  <div>
    <div class="body">
      {{!-- Page header title passed from the controller --}}
      <h1>{{pageHeader.title}}</h1>

      {{!-- Start the list of travel sites/trips --}}
      <ul id="sites">
        {{!-- Loop through each trip object --}}
        {{#each trips}}
          <li>
            {{!-- Show the trip image --}}
            <a href="/api/trips/{{code}}" target="_blank">
              <img src="/images/{{image}}" alt="{{name}}">
            </a>

            {{!-- Show the trip name --}}
            <h2>
              <a href="/api/trips/{{code}}" target="_blank">{{name}}</a>
            </h2>

            {{!-- Show the trip description --}}
            {{{description}}}
          </li>
        {{/each}}
        {{!-- End of trip loop --}}
      </ul>

    </div>
  </div>
</div>
