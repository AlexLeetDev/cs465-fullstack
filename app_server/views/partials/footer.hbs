{{!--
  File: footer.hbs
  Author: Alex Leet
  Course: CS 465 - Full Stack Development I

  Description:
  - This partial contains the shared footer content.
  - Included at the bottom of every page using {{> footer}} in main.hbs.
--}}

<div id="footer">
  <div>
    <ul class="navigation">
      <li class="{{#if (eq activePage 'home')}}active{{/if}}"><a href="/">Home</a></li>
      <li class="{{#if (eq activePage 'travel')}}active{{/if}}"><a href="/travel">Travel</a></li>
      <li class="{{#if (eq activePage 'rooms')}}active{{/if}}"><a href="/rooms">Rooms</a></li>
      <li class="{{#if (eq activePage 'meals')}}active{{/if}}"><a href="/meals">Meals</a></li>
      <li class="{{#if (eq activePage 'news')}}active{{/if}}"><a href="/news">News</a></li>
      <li class="{{#if (eq activePage 'about')}}active{{/if}}"><a href="/about">About</a></li>
      <li class="{{#if (eq activePage 'contact')}}active{{/if}}"><a href="/contact">Contact</a></li>
    </ul>
    <div id="connect">
      <a href="https://pinterest.com/fwtemplates/" class="pinterest" target="_blank"></a>
      <a href="http://freewebsitetemplates.com/go/facebook/" class="facebook" target="_blank"></a>
      <a href="http://freewebsitetemplates.com/go/twitter/" class="twitter" target="_blank"></a>
      <a href="http://freewebsitetemplates.com/go/googleplus/" class="googleplus" target="_blank"></a>
    </div>
  </div>
  <p>{{footerText}}</p>
</div>